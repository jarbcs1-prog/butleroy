.venv/
.uvcache/
models/
*.gguf
*.safetensors
*.onnx
__pycache__/
*.pyc
temp_screen.png
logs/
logs_*.txt
audit/
state/
vendor/**/node_modules/
node_modules/
dist/
.env
*.env.local

# Packaging metadata. Regenerated by `pip install -e .` on every editable
# install, so committing it produces a diff that means nothing and conflicts with
# every other machine's build. `locala.egg-info/` is not the package.
*.egg-info/

# Build artefacts from the Phase 0b source build
build/
_skbuild/
*.obj
*.pdb
*.ilk

# Run logs. ~460 KB of download progress bars and training output, none of it
# evidence. The two build_phase0b*.log files ARE tracked on purpose and are NOT
# covered by this: PLAN.md cites them, and attempt 1 failing is the more useful
# record than attempt 2 succeeding (D29).
*.log
!build_phase0b.log
!build_phase0b_attempt1.log
# Inno Setup places its uninstaller in the install root, which for this
# project IS the repo root (in-place install, policy.SELF_PATHS). These are
# live files - deleting them breaks the uninstaller - so they are ignored,
# never removed.
unins000.*
